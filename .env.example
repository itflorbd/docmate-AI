# ==============================================================================
# DocMate AI — Environment Configuration Template
# Copy this file to `.env` and fill in your values.
# IMPORTANT: Never commit actual secret keys or .env files to source control!
# ==============================================================================

# Application Environment & Base URL
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Database Connection (pgvector enabled)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://docmate:docmate_dev_password@localhost:5432/docmate

# Session & Authentication Secret (Generate e.g. with: openssl rand -base64 32)
AUTH_SECRET=your_auth_session_secret_32_chars_or_more

# Patient PII Encryption Key (AES-256-GCM encryption for phone numbers & identity)
PATIENT_ENCRYPTION_KEY=your_patient_encryption_secret_key_32_bytes

# Demo & Offline Mode Settings
# Set to 'true' to enable synthetic clinical cases, offline accounts & simulated OTP
DOCMATE_DEMO_MODE=true
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

# OpenAI API Settings (For clinical embeddings retrieval)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Optional Maya neural voice. Run the local engine on this loopback port.
# DOCMATE_MAYA_PORT=8319

# Bangladesh SMS Gateway (Optional: For patient OTP delivery in production)
# In development, leave empty to log OTPs to server console via [BD-SMS-STUB]
BD_SMS_GATEWAY_API_KEY=
