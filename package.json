{
  "name": "docmate-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.18.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "start": "node --env-file-if-exists=.env scripts/migrate.mjs && next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "ingest": "node --env-file-if-exists=.env --import tsx scripts/ingest.ts",
    "worker": "node --env-file-if-exists=.env --import tsx scripts/worker.ts",
    "bench:retrieval": "node --env-file-if-exists=.env --import tsx scripts/bench-retrieval.ts",
    "seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "eval": "node --env-file-if-exists=.env --import tsx scripts/run-clinical-eval.ts",
    "eval:chat": "node --env-file-if-exists=.env --import tsx scripts/eval-conversations.ts",
    "eval:rag": "node --env-file-if-exists=.env --import tsx scripts/eval-rag.ts",
    "eval:voice": "node --env-file-if-exists=.env --import tsx scripts/eval-voice.ts",
    "eval:language": "node --env-file-if-exists=.env --import tsx scripts/eval-language.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^7.0.8",
    "@mozilla/readability": "^0.6.0",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/mozilla__readability": "^0.4.2",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "adm-zip": "^0.6.1",
    "argon2": "^0.45.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.77.0",
    "mammoth": "^1.13.0",
    "msedge-tts": "^2.1.1",
    "next": "16.4.6",
    "next-intl": "^4.15.3",
    "next-themes": "^0.4.6",
    "openai": "^7.62.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "react-resizable-panels": "^4.24.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "4.3.3",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/adm-zip": "^0.5.8",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
